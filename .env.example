# Required for stdio / local tools
XENG_API_KEY=sa_your_consumer_key_here

# Optional — x-engine HTTP base URL
XENG_BASE_URL=http://127.0.0.1:8080

# Optional — upstream timeout (Go-style 600s or ms). Default 300000ms
XENG_TIMEOUT=60s
# XENG_TIMEOUT_MS=60000

# Optional — HTTP serve bind (path is fixed at /mcp)
XENG_HOST=127.0.0.1
XENG_PORT=8787

# Optional — log level: debug|info|warn|error
XENG_LOG_LEVEL=info
